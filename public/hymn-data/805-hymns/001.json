  "full_lyrics": [
    {
      "index": "一",
      "content": "至大医生现今可近，满有同情的耶稣；\n祂发恩言愈人忧心，请你即来听耶稣！"
    },
    {
      "index": "副",
      "content": "至佳音，天使在唱；至尊名，人间无双；\n至美歌，天地颂扬；耶稣，可爱耶稣！"
    },
    {
      "index": "二",
      "content": "你罪纵多，祂尽宽恕，请你来听这耶稣；\n一生行走通天的路，终戴华冠如耶稣。"
    },
    {
      "index": "三",
      "content": "荣耀全归复活羔羊！我今诚心信耶稣；\n祂的大名何其芬芳，我爱可爱的耶稣。"
    },
    {
      "index": "四",
      "content": "赦我愆尤，驱我忧惧，别无他名，唯耶稣；\n我心充满何等欣愉，我听有名叫耶稣。"
    },
    {
      "index": "五",
      "content": "弟兄，同来助我歌唱：宝贵的名主耶稣；\n姊妹，也来高声颂扬：无上的名主耶稣。"
    },
    {
      "index": "六",
      "content": "众孩子们无分大小，应当爱戴这耶稣；\n听祂话语，受祂恩召，甘心侍奉这耶稣。"
    },
    {
      "index": "七",
      "content": "不久我们升到天上，就要看见这耶稣；\n环绕宝座敬拜歌唱：至高圣名主耶稣。"
    }
  ],
  "vocabulary": [
    { "word": "愈 (yù)", "meaning": "（病）好，痊愈。" },
    { "word": "纵 (zòng)", "meaning": "虽然，即使。" },
    { "word": "愆尤 (qiān yóu)", "meaning": "罪愆，过犯。愆：过失。" }
  ]
}